# Do not rename this file to *.yaml or commit real values. Create the Secret
# out-of-band, or replace this example with a SOPS-encrypted manifest after
# configuring Flux decryption with your age public key.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: api
type: Opaque
stringData:
  POSTGRES_DB: appdb
  POSTGRES_USER: app
  POSTGRES_PASSWORD: REPLACE_WITH_A_RANDOM_PASSWORD
  CONNECTION_STRING: Host=postgres;Port=5432;Database=appdb;Username=app;Password=REPLACE_WITH_A_RANDOM_PASSWORD
