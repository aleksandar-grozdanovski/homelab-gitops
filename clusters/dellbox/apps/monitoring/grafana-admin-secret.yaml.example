# Do not rename this file to *.yaml or commit real values. Create the Secret
# out-of-band, or commit only a SOPS-encrypted equivalent.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin-credentials
  namespace: monitoring
type: Opaque
stringData:
  admin-user: admin
  admin-password: REPLACE_WITH_A_RANDOM_PASSWORD
